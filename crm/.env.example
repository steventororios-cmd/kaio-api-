# ─── Aventuras CRM — variables de entorno ─────────────────────
# Copia este archivo como .env.local para desarrollo, o configúralas
# en el panel de variables de Vercel para producción.

# ── Supabase ──────────────────────────────────────────────────
# Project Settings → API en el dashboard de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Clave secreta (service_role) — SOLO se usa en el servidor, nunca la expongas al navegador
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Acceso al panel (Fase 1) ────────────────────────────────────
# Password del dueño para entrar al CRM y clave para firmar la cookie de sesión.
# Genera SESSION_SECRET con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRM_OWNER_PASSWORD=changeme
SESSION_SECRET=replace_with_random_64_char_string

# ── OpenAI (Fase 3-4: agente de IA) ─────────────────────────────
OPENAI_API_KEY=

# ── Meta / WhatsApp Cloud API (Fase 2) ──────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── Meta / Messenger (Fase 2) ────────────────────────────────────
MESSENGER_PAGE_ACCESS_TOKEN=
MESSENGER_PAGE_ID=

# ── Meta / Instagram Messaging (Fase 2) ─────────────────────────
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ── Webhook de Meta compartido (Fase 2) ──────────────────────────
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=choose_any_random_string

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
